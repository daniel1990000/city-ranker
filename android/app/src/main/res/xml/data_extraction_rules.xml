<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device-to-device transfer (Android 12+): the save survives a reinstall or a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
