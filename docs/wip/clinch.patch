+
+/** Is the held fighter's back on the cage? */
+export function clinchPinned(f: Fight): boolean {
+  const c = f.state.clinch;
+  if (!c) return false;
+  const held = f.state.fighters[opp(c.ctl)];
+  return held.facing > 0 ? held.x <= -WALL + 20 : held.x >= WALL - 20;
