+    me.prompt = null;
+    me.bufMove = null;
+    me.bufEvade = null;
+    me.bufTicks = 0;
+    me.sprawlReady = false;
+  }
+  placeClinchPair(f, (s.fighters[0].x + s.fighters[1].x) >> 1);
+  s.clinch = { ctl, tick: 0, idle: 0, wall: false, contest: null, trip: null };
+  s.clinch.wall = clinchPinned(f);
+  clinchHoldPose(f, 0);
