+      const d = segDist(a[0], a[1], b[0], b[1]) - a[2] - b[2];
+      if (d < -0.02) pen.push(`${a[3]}~${b[3]} ${Math.round(-d * 100)}cm`);
+    }
+  }
+  const mat: string[] = [];
+  const low: number[] = [];
+  caps.forEach((cs, i) => {
+    let lo = 9;
+    for (const c of cs) {
+      const y = Math.min(c[0].y, c[1].y) - c[2];
+      lo = Math.min(lo, y);
+      if (y < -0.02) mat.push(`${i}:${c[3]} ${Math.round(-y * 100)}cm`);
+    }
+    low.push(Math.round(lo * 1000) / 1000);
+  });
+  return { pen, mat, low };
